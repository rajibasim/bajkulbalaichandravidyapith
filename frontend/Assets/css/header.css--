header{color:#fff;background-color:#efefef}header nav{background:#018339}header nav .bxNav ul li a{color:#fff}header nav .bxNav ul li a.active{color:#f9b129}.bxNav .navigation{width:100%}.bxNav .navigation ul{width:100%;justify-content:center}.sec-headtop{background:#5d2459;color:#fff;padding:10px 0}.content-headtop{display:flex;justify-content:space-between}.content-headtop ul{display:flex;justify-content:space-between;gap:20px;font-size:12px;width:100%}.bxNav{display:flex;justify-content:space-between}.bxNav ul{display:flex}.bxNav ul li{padding:0px 14px}.bxNav ul li a{font-size:16px;font-weight:bold;text-transform:uppercase;padding:16px 8px;display:flex;color:#000}.logo{width:111px;margin-top:-32px;height:111px;border-radius:50%;overflow:hidden;padding:2px;background:#2b286d}.logo img{width:100%}.footer{font-family:Lato,sans-serif;color:#fff;padding:50px 0 0;background-color:#131313}.footer .title-footer{display:flex;justify-content:space-between;margin-bottom:44px;padding-bottom:14px;border-bottom:1px solid #414141}.footer .title-footer h3{font-size:26px;margin-bottom:16px;color:#fff}.footer .title-footer p{font-size:14px;color:#ccc}.footer .link-list-footer{margin-bottom:34px;padding-bottom:44px;border-bottom:1px solid #414141}.footer .link-list-footer ul{display:flex;justify-content:space-between;gap:47px}.footer .link-list-footer ul li{width:25%}.footer .link-list-footer ul li h3{font-size:18px;margin-bottom:28px}.footer .link-list-footer ul li ul{display:flex;flex-wrap:wrap;gap:12px}.footer .link-list-footer ul li ul li{width:100%;font-size:14px}.footer .link-list-footer ul li ul li a{color:#ccc}.footer .bx-copyright{display:flex;justify-content:space-between;padding-bottom:34px}.footer .bx-copyright p{font-size:14px;color:#ccc}.footer .logo-footer a{color:#fff}.footer .social-links{display:flex;gap:8px;margin-top:16px;text-align:center}.footer .social-links a{width:42px;height:42px;color:#fff;background-color:#3e2374;display:flex;justify-content:center;align-items:center}.footer .social-links a:hover{background-color:#f9b129;cursor:pointer}.nav-humberger,.close-nav{display:none}.sec-photoandlogo{background:#f9b129}.sec-photoandlogo .bxphotoandlogo{display:flex;justify-content:space-between;width:100%;align-items:center}.sec-photoandlogo .bxphotoandlogo img{max-width:100%}.sec-photoandlogo .bxphotoandlogo .bpal-photo{max-width:170px;display:flex}.sec-photoandlogo .bxphotoandlogo .bpal-logo{width:140px;height:140px;border-radius:50%;overflow:hidden}.headerImage{display:flex;justify-content:center}.headerImage img{max-width:100%}@media(max-width: 768px){.bxNav ul li a{color:#fff}.nav-humberger{display:none}.navigation{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.99);z-index:99;padding:22px}.close-nav{cursor:pointer;position:fixed;top:18px;right:13px;color:#fff;z-index:999999;width:24px;height:26px;text-align:center;display:none}header nav{position:relative;min-height:50px}header nav .nav-humberger{position:absolute;right:17px;top:13px;color:#037ab1;cursor:pointer}.content-headtop{display:block}.content-headtop ul{display:block}.content-headtop ul li{font-size:12px;text-align:center;color:#ccc;font-weight:bold}.logo{margin-top:0;width:59px}.bxNav{display:block}.bxNav ul{display:block}.bxNav ul li{padding:0px 0px}.bxNav ul li a{padding:16px 0px;border-bottom:1px solid #565656;font-size:14px}.bxNav ul li a:hover{color:#0e7edd}.nav-humberger{display:block}.navigation{display:none;padding:44px 22px 22px 22px}.sec-headtop{padding:6px 0}.footer .title-footer{color:#ccc;flex-wrap:wrap-reverse;text-align:center}.footer .title-footer h3{font-size:22px;margin-bottom:12px;color:#ccc}.footer .title-footer p{font-size:14px}.logo-footer{text-align:center;width:100%;margin-bottom:26px;color:#ccc}.footer{color:#ccc}.footer .link-list-footer ul{flex-wrap:wrap}.footer .link-list-footer ul li{width:100%}.footer .bx-copyright{flex-wrap:wrap;color:#ccc}.footer .bx-copyright .left-copyright{margin-bottom:8px}.footer .bx-copyright .right-copyright{color:#ccc}}@media(max-width: 540px){.sec-photoandlogo .bxphotoandlogo .bpal-photo{max-width:100px}.sec-photoandlogo .bxphotoandlogo .bpal-logo{width:90px;height:90px}.container{padding:0 8px}}